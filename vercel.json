{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd site && bun install --frozen-lockfile",
  "buildCommand": "cd site && bun run validate",
  "outputDirectory": "site/dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/catalog.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "awesome-pi-list.vercel.app" }],
      "destination": "https://piindex.dev/$1",
      "permanent": true
    }
  ]
}
